@page
@model GestorTareas.Pages.Tasks.EditModel

@{
    ViewData["Title"] = "Editar";
}

<h1>Editar Tarea</h1>

<h4>Tarea</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TaskItem.Id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="TaskItem.Title" class="control-label"></label>
                <input asp-for="TaskItem.Title" class="form-control" />
                <span asp-validation-for="TaskItem.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaskItem.Description" class="control-label"></label>
                <input asp-for="TaskItem.Description" class="form-control" />
                <span asp-validation-for="TaskItem.Description" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="TaskItem.IsCompleted" /> @Html.DisplayNameFor(model => model.TaskItem.IsCompleted)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="TaskItem.CreatedAt" class="control-label"></label>
                <input asp-for="TaskItem.CreatedAt" class="form-control" />
                <span asp-validation-for="TaskItem.CreatedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaskItem.DueDate" class="control-label"></label>
                <input asp-for="TaskItem.DueDate" class="form-control" />
                <span asp-validation-for="TaskItem.DueDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Volver al listado</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

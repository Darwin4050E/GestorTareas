@page
@model GestorTareas.Pages.Tasks.DeleteModel

@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar Tarea</h1>

<h3>¿Estás seguro de que querés eliminar esta tarea?</h3>
<div>
    <h4>Tarea</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TaskItem.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TaskItem.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TaskItem.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TaskItem.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TaskItem.IsCompleted)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TaskItem.IsCompleted)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TaskItem.CreatedAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TaskItem.CreatedAt)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TaskItem.DueDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TaskItem.DueDate)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="TaskItem.Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-page="./Index">Volver al listado</a>
    </form>
</div>
